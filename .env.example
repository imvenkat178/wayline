PORT=4174
HOST=127.0.0.1
NODE_ENV=development
# For public use: HTTPS reverse proxy, explicit origin, externally managed 32-byte hex key.
# PUBLIC_ORIGIN=https://wayline.example.com
# DATA_ENCRYPTION_KEY=<64 hexadecimal characters>
# DATA_DIR=/var/lib/wayline
# Only used when NODE_ENV != production, to allow the two-terminal dev workflow below
# (`npm run dev` on one port, `npm start` on another) past the Origin check. Defaults to
# http://127.0.0.1:5173 (Vite's default) even when unset; override only if you run Vite on a
# different port. Has no effect at all in production -- PUBLIC_ORIGIN is the only origin ever
# accepted there.
# DEV_CLIENT_ORIGIN=http://127.0.0.1:5173
SESSION_DAYS=14
ENABLE_EXTERNAL_FEEDS=true
# Optional fixed endpoints. Never accept provider URLs from end users.
# MBTA_API_KEY=
# gtfs-rt reads MBTA vehicles, predictions and alerts from GTFS-Realtime protobuf feeds.
# MBTA_REALTIME_SOURCE=v3-api
# Optional vector map style and the HTTPS origins it loads tiles, glyphs and sprites from.
# MAP_STYLE_URL=https://tiles.example.com/styles/wayline.json
# MAP_TILE_ORIGINS=https://tiles.example.com
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_MS=180000
# Sends LangGraph traces to LangSmith, a third party. Leave off unless you accept that.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# OTP_GRAPHQL_URL=http://127.0.0.1:8080/otp/gtfs/v1
# JSON array of approved GTFS-Realtime sources; see docs/reference/CONFIGURATION.md for the shape.
# TRANSIT_SOURCES_FILE=/etc/wayline/transit-sources.json
# GBFS_URL=https://your-approved-system/gbfs.json
# GBFS_ALLOWED_HOSTS=feeds.example.com,gbfs.example.org
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_USER_AGENT=Wayline/2.0 (contact: your-operations-email)
# VALHALLA_URL=https://your-routing-host/route
# Contact for the Web Push identity (mailto: or https:). Keys are generated in DATA_DIR.
# VAPID_SUBJECT=mailto:operations@example.com
# Required in production for the sandbox commerce webhook; development uses a fixed test value.
# SANDBOX_WEBHOOK_SECRET=
# Operator access must be provisioned by a trusted administrator; registration never grants it.
# Every variable is documented in docs/reference/CONFIGURATION.md.

# Boston core pilot (run npm run transit:setup, transit:build, transit:start first)
# WAYLINE_BOSTON_PILOT=true
# BACKUP_DIR=E:/WaylineBackups
# BACKUP_RECOVERY_KEY_FILE=C:/secure/wayline-backup-key

# Approved flight supplier access. Keep real shopping disabled until supplier access is authorized.
# DUFFEL_ACCESS_TOKEN=
DUFFEL_LIVE_ENABLED=false
DUFFEL_BACKGROUND_SHOPPING_ALLOWED=false
DUFFEL_PRICE_HISTORY_ALLOWED=false

# Supplier transaction gates. Set only after provider approval/certification.
DUFFEL_BOOKING_APPROVED=false
DUFFEL_CARDS_APPROVED=false
DUFFEL_LIVE_CERTIFIED=false
# DUFFEL_WEBHOOK_SECRET=
# Required for live transactions: use the contractual policy, not an invented duration.
# DUFFEL_TRANSACTION_RETENTION_DAYS=
# DUFFEL_RETENTION_POLICY_ID=

# Licensed FlightAware Standard access; raw data and status alerts respect this retention.
FLIGHTAWARE_STANDARD_APPROVED=false
# FLIGHTAWARE_API_KEY=
# FLIGHTAWARE_LICENSE_ID=
# FLIGHTAWARE_RETENTION_DAYS=
