# Settings for the container stack (docker-compose.yml). Copy to .env.container, which git
# ignores, and fill in the required values. Keep this separate from .env: the local
# `npm start` database is encrypted with its own key in data/.encryption-key.
# Every variable is documented in docs/reference/CONFIGURATION.md.

# Required. 64 hexadecimal characters, for example from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes the container database and backups unreadable.
DATA_ENCRYPTION_KEY=

# Required. The exact origin travelers use to open Wayline.
PUBLIC_ORIGIN=http://localhost:4174

WAYLINE_BOSTON_PILOT=true
ENABLE_EXTERNAL_FEEDS=true
SESSION_DAYS=14
# MBTA_API_KEY=

# Optional local model running on the host machine.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
# OLLAMA_TIMEOUT_MS=180000

# Web Push contact, and the sandbox webhook secret required in production.
# VAPID_SUBJECT=mailto:operations@example.com
# SANDBOX_WEBHOOK_SECRET=
